BUS_PORT=47830
BUS_DATA=/data/bus.jsonl

# role:token pairs seeded at start. Identity comes from the token, so a sender cannot be spoofed.
# Everyone else joins by invite from the group chat.
BUS_TOKENS=front:REPLACE_ME_FRONT
# Names above that are people using the REST hold/release, not agents.
BUS_HUMANS=
# Telegram user ids allowed to invite and remove roles.
BUS_ADMINS=111111111

# How many exchanges a thread gets before only an escalation is allowed.
BUS_MAX_HOPS=6

# Telegram mirror and controls (optional, strongly recommended).
BUS_TG_TOKEN=
BUS_TG_CHAT=

# Owners of seeded roles: who approves setup proposals for them. Invited roles get theirs from the invite.
BUS_OWNERS=front:111111111

# Chat language (en | ru) and how each agent is shown in the feed.
BUS_LANG=en
BUS_LABELS=front:🔵 <b>Frontend</b>
