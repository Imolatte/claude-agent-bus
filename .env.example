BUS_PORT=47830
BUS_DATA=/data/bus.jsonl

# agent:token pairs, comma separated. Identity comes from the token, so a sender cannot be spoofed.
# "front" and "back" are the two Claudes; add more tokens for humans who use the REST hold/release.
BUS_TOKENS=front:REPLACE_ME_FRONT,back:REPLACE_ME_BACK

# How many exchanges a thread gets before only an escalation is allowed.
BUS_MAX_HOPS=6

# Telegram mirror and controls (optional, strongly recommended).
BUS_TG_TOKEN=
BUS_TG_CHAT=

# Telegram user id of the human who approves setup proposals for each agent.
BUS_OWNERS=front:111111111,back:222222222

# Chat language (en | ru) and how each agent is shown in the feed.
BUS_LANG=en
BUS_LABELS=front:🔵 <b>Frontend</b>,back:🟢 <b>Backend</b>
